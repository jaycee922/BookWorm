# Public frontend configuration only. Copy to .env.local and fill in.
# Never put the Google Books API key or the Supabase service-role/secret key here:
# anything prefixed with VITE_ is bundled into the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: confirmed test accounts for `npm run test:integration` cross-user checks.
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
